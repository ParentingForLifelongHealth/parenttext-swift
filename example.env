## python -m parenttext.ckan_tools --file contacts.csv --dataset saswift_contacts --resource-name "SWIFT Contacts Research Export" --reconcile "uuid"


# Settings for uploading contacts to group, replace upload file/ group name as desired
UPLOAD_FILE=1month_failed_notifications.csv
UPLOAD_GROUP_NAME=1month notification failed
