RAPIDPRO_URL=https://za.rapidpro.idems.international
RAPIDPRO_API_TOKEN=

CKAN_URL=https://sds.plhdashboard.org/
CKAN_API_KEY=


## Settings for the normal contacts upload
CKAN_OWNER_ORG=idems_ptext_sa_swift
CKAN_DATASET=saswift_contacts
CKAN_RESOURCE_NAME=SWIFT Contacts Research Export
DENYLIST_FIELDS=sq 3m parentintn, sq 3m teenintn, sq 3m teenintname, sq 3m teenintparn, certificate_name, sq_cert_name, child_nickname, sq_base_childname
IGNORE_CONSENT_COLUMN=TRUE
